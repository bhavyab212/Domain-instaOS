# ==============================================================
# InstaOS Autonomous Engine — Environment Configuration
# ==============================================================

# OpenRouter / OpenAI-compatible Open-Source LLM API
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=sk-or-v1-your_openrouter_api_key_here
LLM_MODEL=dots-studio/dots-3-note-preview:free

# Public Base URL (for Keepalive and file download links)
PUBLIC_BASE_URL=http://localhost:8000

# Nonilion Room Callback URL (optional for real-time outbound webhooks)
NONILION_CALLBACK_URL=

# Autonomous Shipping Pipeline delay between stage transitions (seconds)
SHIPPING_STAGE_DELAY_SEC=15

# Artifact Output Directory
STATIC_DIR=generated_files
